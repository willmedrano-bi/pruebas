app.MapGet("/api/token", async (HttpContext context) =>
{
    var accessToken = await context.GetTokenAsync(
        CookieAuthenticationDefaults.AuthenticationScheme,
        "access_token");

    var refreshToken = await context.GetTokenAsync(
        CookieAuthenticationDefaults.AuthenticationScheme,
        "refresh_token");

    var expiresAt = await context.GetTokenAsync(
        CookieAuthenticationDefaults.AuthenticationScheme,
        "expires_at");

    return Results.Ok(new
    {
        hasAccessToken = !string.IsNullOrWhiteSpace(accessToken),
        hasRefreshToken = !string.IsNullOrWhiteSpace(refreshToken),
        expiresAt
    });
}).RequireAuthorization();


