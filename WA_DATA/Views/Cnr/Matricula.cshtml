@using Library.Models.DTOs.Cnr

@{
    ViewData["Title"] = "Consulta CNR por Matrícula";
}
<style>
    .btn-broom {
        background-color: #f1c40f !important; /* Cambia a tu color deseado */
        color: #2c2c2c !important;
        border: none !important;
    }

        .btn-broom:hover, .btn-broom:focus {
            background-color: #ffe066 !important;
            color: #222 !important;
        }</style>

<main class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">

    <div id="titles" class="col-12 col-md-8 col-lg-7 animate__animated animate__fadeIn animate__faster text-center mb-3">
        <h1 class="fw-semibold text-dark h3">
            <i class="fas fa-search text-primary pe-2"></i> Busqueda por matrícula
        </h1>
        <div class="text-muted text-center">
            <small>Ingrese la matrícula que deseas consultar.</small>
        </div>
    </div>

    <div id="Buscador" class="card rounded-4 border-0 shadow-sm animate__animated animate__fadeInUp col-12 col-md-8 col-lg-7 mb-3">
        <div class="card-body p-4">
            @(Html.DevExtreme().Form<MatriculaRequest>()
                .ID("matriculaForm")
                .FormData(new { matricula = "" })
                .ColCount(10)
                .Items(items =>
                {
                    items.AddSimple()
                    .ColSpan(7)
                    .DataField("matricula")
                    .Editor(editor => editor.TextBox()
                    .ShowClearButton(true)
                    .Placeholder("Ingrese la matricula"))
                    .Label(l => l.Text("Matricula"));

                    items.AddButton()
                    .ColSpan(2)
                    .HorizontalAlignment(HorizontalAlignment.Right)
                    .ButtonOptions(b => b
                    .Text("Consultar")
                    .Type(ButtonType.Default)
                    .Icon("search")
                    .StylingMode(ButtonStylingMode.Contained)
                    .Width("100%")
                    .OnClick("consultarMatricula"));

                    items.AddButton()
                    .ColSpan(1)
                    .HorizontalAlignment(HorizontalAlignment.Left)
                    .ButtonOptions(b => b
                    .Icon("fas fa-arrow-rotate-left")
                    .StylingMode(ButtonStylingMode.Contained)
                    .Width("100%")
                    .OnClick("limpiarDuiResultado"));

                })
                )
        </div>
    </div>
    <div id="matricula" class=" col-12 col-md-8 col-lg-7 mb-4 align-items-center"> </div>

</main>

<script>
    function consultarMatricula() {
        const form = $("#matriculaForm").dxForm("instance");
        const matricula = form.option("formData").matricula;
        loadingPanel.show();
        DevExpress.ui.notify("Consultando...", "info", 2000);

        fetch('/Cnr/ConsultarDatosMatricula', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ matricula })
        })
        .then(res => {
        if (!res.ok) return handleHttpError(res);
            return res.json();
        })
        .then(result => {
            if (result?.success) {
    document.getElementById("titles").classList.remove("text-center","mb-3");
                    document.getElementById("titles").classList.add("titles_small","text-start","mb-2","ps-3");
                DevExpress.ui.notify("Registro encontrado", "success", 3000);
                cargarMatricula(result.data);
            } else {
                DevExpress.ui.notify(result.message || "No se encontró información", "error", 3000);
            }
        })
        .catch(err => {

        })
        .finally(() => {
            loadingPanel.hide();
        });;
    }

    function cargarMatricula(data) {

        fetch('/Cnr/ConsultarDatosMatriculaPartial', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(res => res.text())
        .then(html => {
            $("#matricula").html(html);
        });
    }
    function limpiarDuiResultado() {
        $("#matricula").empty();
          $("#titles").slideDown(200);
                document.getElementById("titles").classList.add("text-center","mb-3");
                document.getElementById("titles").classList.remove("titles_small","text-start","mb-2","ps-3");


    }
</script>