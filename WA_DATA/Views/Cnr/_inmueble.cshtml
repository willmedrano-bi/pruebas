@using Library.Models.DTOs.Cnr
@model Inmueble
 <h3 class="mb-3 text-primary-emphasis h6">Datos del inmueble:</h3>
 
        <div class="container-fluid px-0">
            <div class="row mb-2">
                <div class="col-12 col-md-3 text-primary fw-normal">Estado parcela:</div>
                <div class="col-12 col-md-3">@Model.EstadoParcela</div>
                <div class="col-12 col-md-3 text-primary fw-normal">Area:</div>
                <div class="col-12 col-md-3">@Model.Area</div>
            </div>
            <div class="row mb-2">
                <div class="col-12 col-md-3 text-primary fw-normal">Perimetro:</div>
                <div class="col-12 col-md-3">@Model.Perimetro</div>
                <div class="col-12 col-md-3 text-primary fw-normal">Uso:</div>
                <div class="col-12 col-md-3">@Model.Uso</div>
            </div>
            <div class="row mb-2">
                <div class="col-12 col-md-3 text-primary fw-normal">Tipo parcela:</div>
                <div class="col-12 col-md-9">@Model.TipoParcela</div>
            </div>
        </div>