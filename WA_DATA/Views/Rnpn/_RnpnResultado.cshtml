@model Library.Models.DTOs.Rnpn.RnpnData
@if (Model != null)
{
    <div class="card border-0 rounded-4 shadow-sm p-1 p-sm-2 p-md-3 p-lg-5 mt-2 mx-auto animate__animated animate__fadeInUp animate__faster">
        <div class="d-flex justify-content-start align-items-center mb-4">
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-check-circle text-success align-items-center fs-5"></i>
                <h2 class="h6 mb-0">Resultado de Consulta: </h2>
            </div>
        </div>

        <div class="table-responsive ">
            <table class="table border-info-subtle align-middle mb-0">
                <tbody>
                    <tr>
                        <th class="text-primary fw-normal w-25">DUI</th>
                        <td >@Model.dui</td>
                    </tr>
                    <tr>
                        <th class="text-primary fw-normal">Nombre completo</th>
                        <td >@Model.nom1 @Model.nom2 @Model.nom3 @Model.ape1 @Model.ape2 @Model.apdoCsda</td>
                    </tr>
                    <tr>
                        <th class="text-primary fw-normal">Fecha nacimiento</th>
                        <td >@Model.fechNaci</td>
                    </tr>
                    <tr>
                        <th class="text-primary fw-normal">Lugar de Nacimiento</th>
                        <td >@Model.nombPaisNaci, @Model.nombDeptNaci, @Model.rMuniNaci (@Model.nombMuniNaci)</td>
                    </tr>
                    <tr>
                        <th class="text-primary fw-normal">Lugar de Emisión</th>
                        <td >@Model.paisExpe, @Model.deptExpe, @Model.rMuniEmisDui (@Model.muniExpe)</td>
                    </tr>
                    <tr>
                        <th class="text-primary fw-normal">Lugar de Domicilio</th>
                        <td >@Model.paisDomi, @Model.deptDomi, @Model.rMuniDomic (@Model.municDomi)</td>
                    </tr>
                    <tr>
                        <th class="text-primary fw-normal">Fecha emisión</th>
                        <td >@Model.fechExpe</td>
                    </tr>
                    <tr>
                        <th class="text-primary fw-normal">Fecha vencimiento</th>
                        <td >@Model.fechVenc</td>
                    </tr>
                    <tr>
                        <th class="text-primary fw-normal">Estado Civil</th>
                        <td >@Model.estaFami</td>
                    </tr>
                    <tr>
                        <th class="text-primary fw-normal">Profesión</th>
                        <td >@Model.profesion</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

