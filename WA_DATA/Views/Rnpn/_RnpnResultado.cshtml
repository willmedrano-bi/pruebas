    @if (Model.conoPor != null && Model.conoPor.Any())
    {
        <div class="mb-4">
            <h4>Conocido Por</h4>
            @(Html.DevExtreme().DataGrid()
                .ID("gridConocidoPor")
                .DataSource(Model.conoPor)
                .ShowBorders(true)
                .ColumnAutoWidth(true)
                .WordWrapEnabled(true)
                .RowAlternationEnabled(true)
                .ColumnHidingEnabled(true)
                .SearchPanel(sp => sp.Visible(true).Width(250).Placeholder("Buscar..."))
                .Paging(p => p.PageSize(10))
                .Pager(p => p.ShowPageSizeSelector(true).AllowedPageSizes(new[] { 10, 20, 50 }).ShowInfo(true))
                .Columns(columns =>
                {
                    columns.Add().DataField("nom1").Caption("Primer Nombre");
                    columns.Add().DataField("nom2").Caption("Segundo Nombre");
                    columns.Add().DataField("nom3").Caption("Tercer Nombre");
                    columns.Add().DataField("ape1").Caption("Primer Apellido");
                    columns.Add().DataField("ape2").Caption("Segundo Apellido");
                    columns.Add().DataField("apdoCsda").Caption("Apellido de Casada");
                })
                )
        </div>
    }
}