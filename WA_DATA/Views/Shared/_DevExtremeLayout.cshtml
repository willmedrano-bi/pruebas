@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}



<body style="height: 100vh">
    <div  id="loadPanel"></div>

    <nav class="sidebar" id="sidebar" aria-label="Menú principal">
        <div class="d-md-none text-end pe-3">
            <button class="btn btn-sm btn-light mt-2" onclick="closeSidebar()">
                <i class="fas fa-arrow-left"></i>
            </button>
        </div>
        <div class="d-none d-md-flex justify-content-center mt-1 mb-3">
            <button class="btn btn-outline-light btn-sm border-0" onclick="toggleCollapseSidebar()">
                <i class="fas fa-angle-left" id="collapse-icon"></i>
            </button>
        </div>
        <div class="text-center mb-3">
            <img src="@Url.Content("~/Assets/media/logo_expanded.svg")"
            class="img-fluid logo-expanded" alt="Logo grande" />
            <img src="@Url.Content("~/Assets/media/logo_minimized.svg")"
            class="img-fluid logo-minimized d-none" alt="Logo pequeño" />
        </div>
        <hr class="border-light mx-3 d-none d-md-block" />
        <ul class="nav-link-cont list-unstyled mb-0">

            <li class="nav-link mb-1 @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                <a href="@Url.Action("Index", "Home")">
                    <i title="Inicio" class="fa-solid fa-home"></i>
                    <span class="menu-text">Inicio</span>
                </a>
            </li>
            @if (User.IsInRole("rnpn-rol"))
            {
                <li class="sidebar-divider mb-3"><span><small>RNPN</small></span></li>

                <li class="nav-link mb-2 @(currentController == "Rnpn" && currentAction == "Index" ? "active" : "")">
                    <a href="@Url.Action("Index", "Rnpn")">
                        <i title="Consulta Rnpn" class="fa-solid fa-id-card"></i>
                        <span class="menu-text">Buscar Documento</span>
                    </a>
                </li>
                <li class="nav-link mb-2 @(currentController == "Rnpn" && currentAction == "Historico" ? "active" : "")">
                    <a href="@Url.Action("Historico", "Rnpn")">
                        <i title="Consulta Rnpn" class="fa-solid fa-scroll"></i>
                        <span class="menu-text">Buscar Histórico</span>
                    </a>
                </li>
                <li class="nav-link mb-2 @(currentController == "Rnpn" && currentAction == "Nombre" ? "active" : "")">
                    <a href="@Url.Action("Nombre", "Rnpn")">
                        <i title="Consulta Rnpn" class="fa-solid fa-user"></i>
                        <span class="menu-text">Buscar Nombre</span> 
                    </a>
                </li>
            }
            @if (User.IsInRole("cnr-rol"))
            {
                <li class="sidebar-divider my-3"><span><small>CNR</small></span></li>

                <li class="nav-link mb-2 @(currentController == "Cnr" && currentAction == "Index" ? "active" : "")">
                    <a href="@Url.Action("Index", "Cnr")">
                        <i title="Buscar Empresa" class="fa-solid fa-landmark"></i>
                        <span class="menu-text">Buscar Empresa</span>
                    </a>
                </li>
                <li class="nav-link mb-2 @(currentController == "Cnr" && currentAction == "Entidad" ? "active" : "")">
                    <a href="@Url.Action("Entidad", "Cnr")">
                        <i title="Buscar Empresa" class="fa-solid fa-money-check"></i>
                        <span class="menu-text">Entidad completa</span>
                    </a>
                </li>
                <li class="nav-link mb-2 @(currentController == "Cnr" && currentAction == "Matricula" ? "active" : "")">
                    <a href="@Url.Action("Matricula", "Cnr")">
                    <i title="Buscar Matrícula" class="fa-solid fa-file-circle-question"></i>
                    <span class="menu-text">Buscar Matrícula</span>
                </a>
            </li>
            }
           @*  <li class="sidebar-divider"><span>Adm</span></li>

            @* <li class="nav-link">
            <a href="#"><i title="Configuración" class="fas fa-cog"></i>
                <span class="menu-text">Configuración</span>
            </a>
        </li> 

            <li class="nav-link mb-3">
                <a href="@Url.Action("Logout", "Account")">
                    <i title="Cerrar sesión" class="fas fa-sign-out-alt"></i>
                    <span class="menu-text">Cerrar sesión</span>
                </a>
            </li> *@
        </ul>
    </nav>

    <div class="content d-flex flex-column min-vh-100">

        <div class="topbar rounded d-flex align-items-center p-3">
            <button class="btn btn-outline-light d-lg-none me-2" type="button" onclick="toggleSidebar()" aria-label="Mostrar menú lateral">
                <i class="fas fa-bars"></i>
            </button>

            <div class="flex-grow-1">           </div>

            <div class="user-info d-flex align-items-center gap-2 flex-wrap flex-sm-nowrap">
                <div class="dropdown">
                    <button class="btn btn-link text-light dropdown-toggle px-2 px-sm-3"
                            type="button" id="userDropdown" data-bs-toggle="dropdown"
                            aria-expanded="false"
                            style="text-decoration: none; text-overflow: ellipsis;">
                       @ViewBag.Empleado.PrefijoAcademico @ViewBag.Empleado.Nombres <span class="d-none d-md-inline"> @ViewBag.Empleado.Apellidos</span>
                    </button>
                    <ul class="dropdown-menu  dropdown-menu-nav dropdown-menu-end dropdown-menu-dark w-100" aria-labelledby="userDropdown">
                        <li>
                            <a class="dropdown-item text-white" href="https://login.asa.gob.sv/realms/Interno/account">
                                <i class="fas fa-cog me-2"></i> Ajustes
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                <i class="fas fa-sign-out-alt me-2"></i> Cerrar sesión
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="flex-shrink-0">
                    <img src="https://talentohumano.asa.gob.sv/Content/ImagenesEmpleado/@ViewBag.Empleado.FotoEmpleado"
                         alt="Foto de usuario"
                         class="rounded-circle border border-1"
                         style="width: 36px; height: 36px; object-fit: cover;" />
                </div>
            </div>
        </div>


        <main class="mt-3 mb-4">
            
            @RenderBody()
        </main>

        <footer class="d-flex align-items-center justify-content-center gap-2 text-dark py-1 px-3 mt-auto w-100 bg-light">
            <small class="mb-0">
                &copy; @DateTime.Now.Year Autoridad Salvadoreña del Agua · En cooperación con
            </small>
            <img src="~/assets/media/logos_cnr_rnpn-01.svg" alt="Logos CNR RNPN" style="height: 20px;" />
        </footer>
        @(Html.DevExtreme().TextBox().Value("N").ReadOnly(true).Visible(false))
    </div>

     <script>
        function toggleSidebar() {
            document.getElementById("sidebar").classList.toggle("show");
        }

        function closeSidebar() {
            document.getElementById("sidebar").classList.remove("show");
        }

        function toggleCollapseSidebar() {
            const sidebar = document.getElementById("sidebar");
            const content = document.querySelector(".content");

            sidebar.classList.toggle("collapsed");
            content.classList.toggle("collapsed");

            const icon = document.getElementById("collapse-icon");
            icon.classList.toggle("fa-angle-left");
            icon.classList.toggle("fa-angle-right");
        }

        document.addEventListener("DOMContentLoaded", () => {
            const sidebarLinks = document.querySelectorAll("#sidebar a");
            sidebarLinks.forEach(link => {
                link.addEventListener("click", () => {
                    if (window.innerWidth <= 768) {
                        closeSidebar();
                    }
                });
            });
        });



        function mostrarCargando() {
            loadingPanel.show(); // Muestra el panel
            return true; // Permite el submit
        }
        var loadingPanel = $("#loadPanel").dxLoadPanel({
            message: "Procesando...",
            shadingColor: "rgba(0,0,0,0.4)",
            position: { of: "body" },
            visible: false,
            showIndicator: true,
            showPane: true
        }).dxLoadPanel("instance");

                function handleHttpError(response, customRedirect = true) {
            return response.json().then(error => {
                const message = response?.Message || "Ocurrió un error inesperado.";

                switch (response.status) {
                    case 401:
                        DevExpress.ui.notify("Sesión expirada. Redirigiendo...", "warning", 3000);
                        if (customRedirect) {
                            setTimeout(() => location.reload(), 1500);
                        }
                        break;
                    default:
                        DevExpress.ui.notify("Error inesperado: " + message, "error", 3000);
                }

                throw new Error(message);
            });
        }

                document.addEventListener("DOMContentLoaded", () => {
            const sidebarLinks = document.querySelectorAll("#sidebar a");

            sidebarLinks.forEach(link => {
                link.addEventListener("click", function (e) {
                  
                    if (this.getAttribute("href") && this.getAttribute("href") !== "#") {
                        e.preventDefault(); 
                        const href = this.getAttribute("href");

                        this.classList.add("clicked");

                        setTimeout(() => {
                            window.location.href = href;
                        }, 110); 
                    }
   
                    if (window.innerWidth <= 991) {
                        closeSidebar();
                    }
                });
            });
        });

  


    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
</body>

</html>